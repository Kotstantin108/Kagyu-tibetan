{
  "name": "kagyu-tibetan",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Classical Tibetan with sentence tiles. Static site, no build step.",
  "type": "module",
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test \"site/src/**/*.test.js\" \"server/**/*.test.js\"",
    "serve": "npx serve site",
    "smoke": "node scripts/smoke.mjs",
    "icon": "python scripts/tools/make-icon.py && node scripts/tools/icon-png.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
